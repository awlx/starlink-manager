# Copy to .env for local runs (go run or docker-compose.local.yaml).
# .env is git-ignored — NEVER commit real values.

# Starlink account credential: the durable Starlink.Com.Sso cookie value
# from a browser login at starlink.com. Required.
STARLINK_SSO_COOKIE=

# Optional: browser session cookie trio (one line, semicolon-separated). Not
# needed normally: the app obtains these cookies from the SSO cookie through
# the silent web login and renews access tokens from them.
#   Starlink.Com.Access.V1=...; Starlink.Com.Access.V1C1=...; Starlink.Com.Access.V1C2=...
#STARLINK_REFRESH_COOKIES=

# Server
LISTEN_ADDR=:8080
STARLINK_DATA_DIR=data

# Polling / history
STARLINK_POLL_INTERVAL=30s
STARLINK_HISTORY_WINDOW=24h
STARLINK_CALL_TIMEOUT=12s

# Authentication (dev: localdev; production: forwardauth behind Traefik)
AUTH_MODE=localdev
LOCAL_DEV_USER=true
# OIDC (only needed when AUTH_MODE=oidc)
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/ffmuc
# OIDC_CLIENT_ID=starlink-manager
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:8080/callback
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_GROUPS=ffmuc-admin
# Random session cookie secret, >= 32 chars (required in oidc/forwardauth)
SESSION_COOKIE_SECRET=
